# Copy to .env.local and fill in. All VITE_* vars are inlined into the
# client bundle at build time — never put a secret here for a real deploy.

# Optional: override the GitHub API base URL.
VITE_GITHUB_API_URL=https://api.github.com

# Optional: a GitHub personal access token raises the rate limit from
# 60 to 5,000 requests/hour. NOTE: because Vite inlines this into the
# shipped JS, the token is PUBLIC to anyone who loads the app.